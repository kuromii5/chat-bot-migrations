FROM golang:1.25.6-alpine

# Pin the tool: installing "@latest" made image builds non-reproducible.
ARG SQL_MIGRATE_VERSION=v1.8.1
RUN go install github.com/rubenv/sql-migrate/sql-migrate@${SQL_MIGRATE_VERSION}

# envsubst is used to inject schema/role names into dbconfig.yml and *.sql.
RUN apk add --no-cache gettext

WORKDIR /migrations
COPY . .

# Kept as a separate file on purpose: a RUN heredoc is parsed by the Dockerfile
# frontend (BuildKit) instead of /bin/sh, which produced an empty entrypoint
# and "exec format error" at container start.
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
